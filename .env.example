# PostgreSQL (Neon). Endpoint AVEC -pooler pour l'application…
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/axio?sslmode=require"
# …et endpoint DIRECT (sans -pooler) pour la CLI Prisma : db push, migrate, seed.
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/axio?sslmode=require"

# Signature des sessions : 32 octets aléatoires (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET="remplacez-par-une-valeur-aleatoire-32-octets"

# Rédaction du copilote : "local" (déterministe, aucun appel externe) ou "anthropic"
AI_PROVIDER="local"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
